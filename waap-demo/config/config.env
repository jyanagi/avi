# ============================================================================
# Avi WAAP-for-AI / MCP demo kit - master configuration
# ----------------------------------------------------------------------------
# This is the ONLY file you must edit before deploying. Every script reads it.
# Fill in the values for your environment, then follow the README.
# No value here should contain spaces unless quoted.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. vSphere target (where the demo VMs are created)
# ---------------------------------------------------------------------------
VSPHERE_SERVER="vcenter.example.local"        # vCenter FQDN or IP
VSPHERE_USER="administrator@vsphere.local"
VSPHERE_PASSWORD="CHANGE_ME"
VSPHERE_INSECURE="true"                        # true = skip TLS verify (lab)
VSPHERE_DATACENTER="DC1"
VSPHERE_CLUSTER="Cluster1"
VSPHERE_DATASTORE="datastore1"
VSPHERE_FOLDER="waap-mcp-demo"                 # VM folder to create/use
VSPHERE_NETWORK="VM Network"                   # port group for the demo VMs
VSPHERE_RESOURCE_POOL=""                       # optional; blank = cluster root

# Base template to clone. Must be an existing, powered-off Ubuntu 22.04 or
# 24.04 template with cloud-init and open-vm-tools installed, and a user the
# kit can SSH into (see TEMPLATE_SSH_USER below).
VSPHERE_TEMPLATE="ubuntu-2404-template"
TEMPLATE_SSH_USER="ubuntu"                     # sudo-capable user in the template

# ---------------------------------------------------------------------------
# 2. Demo VM addressing (static IPs recommended for a repeatable demo)
# ---------------------------------------------------------------------------
# The kit creates three VMs: mcp-a, mcp-b, and the agent/demo host.
# Keycloak and the dashboard run on the agent/demo host.
NET_GATEWAY="10.10.10.1"
NET_NETMASK="24"
NET_DNS="10.10.10.1"
NET_DOMAIN="demo.lab"

MCP_A_NAME="acme-mcp-a"
MCP_A_IP="10.10.10.21"
MCP_B_NAME="acme-mcp-b"
MCP_B_IP="10.10.10.22"
AGENT_NAME="acme-agent"
AGENT_IP="10.10.10.20"

# ---------------------------------------------------------------------------
# 3. Avi Controller (assumed already deployed with a working vSphere cloud)
# ---------------------------------------------------------------------------
AVI_CONTROLLER="10.10.10.10"                   # controller IP or FQDN
AVI_USER="admin"
AVI_PASSWORD="CHANGE_ME"
AVI_TENANT="admin"
AVI_CLOUD="Default-Cloud"                       # existing cloud name on the controller
AVI_SE_GROUP="Default-Group"                    # existing SE group
AVI_VS_NETWORK="10.10.10.0/24"                  # network the VS VIP lives on
AVI_VIP="10.10.10.50"                           # VIP address for the MCP virtual service
AVI_VERSION="32.1.1"                            # controller version (for API compat)

# ---------------------------------------------------------------------------
# 4. Object names created on Avi (rename only if you must avoid collisions)
# ---------------------------------------------------------------------------
OBJ_PREFIX="AI"
CERT_NAME="AI-MCP-Cert"
PKI_PROFILE="AI-Agent-PKI"
JWT_PROFILE="AI-JWT-ServerProfile"
AUTH_PROFILE="AI-JWT-AuthProfile"
SSO_POLICY="AI-SSO-Policy"
WAF_PROFILE="AI-WAF-Profile"
WAF_POLICY="AI-WAAP-Policy"
APP_PROFILE="AI-MCP-AppProfile"                 # cloned from System-Secure-HTTP-MCP
HEALTH_MONITOR="AI-MCP-HealthMonitor"
POOL_NAME="AI-MCP-L7-Vs-Pool"
VS_NAME="AI-MCP-L7-Vs"

# ---------------------------------------------------------------------------
# 5. TLS / PKI (self-signed CA is generated by the kit; no external CA needed)
# ---------------------------------------------------------------------------
CA_CN="ACME Demo Root CA"
SERVER_CN="mcp.demo.lab"                         # SAN also covers waap./agent.
CLIENT_CN="agent.demo.lab"                       # client cert for the agent (mTLS)
CERT_DAYS="825"

# ---------------------------------------------------------------------------
# 6. Keycloak (runs as a systemd service on the agent/demo host)
# ---------------------------------------------------------------------------
KC_ADMIN_USER="admin"
KC_ADMIN_PASSWORD="CHANGE_ME"
KC_REALM="acme-ai"
KC_HTTPS_PORT="8443"
# Three tier clients. Secrets are generated if left as CHANGE_ME.
KC_CID_CATALOG="agent-catalog"
KC_SECRET_CATALOG="CHANGE_ME"
KC_CID_OPS="agent-ops"
KC_SECRET_OPS="CHANGE_ME"
KC_CID_FINANCE="agent-finance"
KC_SECRET_FINANCE="CHANGE_ME"

# ---------------------------------------------------------------------------
# 7. Backend service users / paths (rarely changed)
# ---------------------------------------------------------------------------
BACKEND_USER="acme"                             # nologin service user on MCP nodes
BACKEND_DIR="/opt/acme-ai"
MCP_PORT="8443"
LLM_PORT="9443"
DEMO_DIR="/opt/waap-demo"                        # dashboard + tools on agent host
DASHBOARD_PORT="8700"

# ---------------------------------------------------------------------------
# 8. Demo behavior toggles
# ---------------------------------------------------------------------------
FAILOVER_WAIT="8"                               # seconds agent waits during failover
RESUME_SESSIONS="1"                             # 1 = surviving node adopts sessions
