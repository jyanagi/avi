# Shared configuration for the Avi WAF Log4Shell demo.
# Installed to /etc/log4shell-demo.env and read by every systemd unit.
# Edit these to match your lab, then: systemctl restart 'log4shell-*'

# --- Node pool members (reached on the proxy port 8080) ---
NODE_A=http://10.15.148.84:8080
NODE_B=http://10.15.148.85:8080

# --- Avi virtual service (WAF in path). Uses the internal DemoRootCA. ---
VS_URL=https://log4j.us-east.demo.lab

# --- JNDI canary sink: host:port embedded in every payload. ---
# This must be the 03a address reachable by BOTH vulnerable nodes.
CANARY_SINK=10.15.148.84:1389
CANARY_HOST=0.0.0.0
CANARY_PORT=1389

# --- Where callbacks are journaled (canary writes, console reads) ---
CALLBACKS_FILE=/var/lib/log4shell-demo/callbacks.jsonl

# --- Operator console ---
CONSOLE_PORT=9090

# --- Front proxy -> local vulnerable container ---
PORT=8080
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8081
