[Unit]
Description=Log4Shell demo front proxy (adds X-Served-By, fronts vuln container)
After=network-online.target docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/log4shell-demo.env
ExecStart=/usr/bin/node /opt/log4shell-demo/node-proxy.js
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
